---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cards from '../components/Cards.astro';
import projects from '../data/home.json';
import Social from '../components/Social.astro';
import { pageTag, pageDescription, homeTdk } from '../data/content';
---
<BaseLayout title={homeTdk.title} description={homeTdk.description} keywords={homeTdk.keywords}>
  <main class="studio">
    <section class="opening" aria-labelledby="opening-title">
      <div class="opening-top"><span><i></i> {pageTag.index} / IDEAS IN MOTION</span><span>INGNAH — DESIGN EXPLORATIONS</span></div>
      <div class="opening-composition">
        <div class="hero-copy"><span class="archive-label">个人创作档案 / VOL. 01</span><h1 id="opening-title"><span class="line-mask"><span class="title-line">把想法，</span></span><span class="line-mask"><span class="title-line title-second">变成<span class="highlight">作品。</span></span></span></h1><p class="hero-note">设计 × 编程 × 持续探索</p><a class="hero-button" href="#selected-work">打开作品档案 <span aria-hidden="true">↗</span></a></div>
        <div class="graphic" aria-hidden="true">
          <span class="floating-tag tag-one">IDEA → FORM</span>
          <div class="graphic-disc"><img src="/images/archive-placeholder.png" width="1536" height="1024" alt="" fetchpriority="high" /></div>
          <div class="project-slips">{projects.slice(0,3).map((project,i)=><div class="project-slip" style={`--i:${i}`}><img src={project.cover} alt="" /><span>EXPLORATION / 0{i+1}</span></div>)}</div>
          <span class="floating-tag tag-two">持续更新中 ✳</span>
          <span class="graphic-caption">INGNAH / SELECTED WORKS</span>
        </div>
      </div>
      <div class="opening-bottom">
        <div class="opening-description"><p>{pageDescription.index}</p><Social /></div>
        <a class="discover" href="#selected-work"><span>向下，看看作品</span><span class="circle-arrow" aria-hidden="true">↓</span></a>
        <span class="index-note">SCROLL TO EXPLORE<br />VISUAL / DIGITAL / EXPERIMENTAL</span>
      </div>
    </section>
    <div class="archive-strip" aria-hidden="true"><span>DESIGN</span><i>✳</i><span>CODE</span><i>✳</i><span>EXPLORE</span><i>✳</i><span>CREATE</span></div>
    <section class="selected-work" id="selected-work" aria-labelledby="work-title">
      <div class="work-heading"><div><span class="eyebrow">01 / THE ARCHIVE</span><h2 id="work-title">每一次尝试，都在这里<svg class="work-heading-arrow" aria-hidden="true" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 8 30 30M12 38h26V12" /></svg></h2></div><p>视觉、交互与创意实验。<br /><span class="sample-note">原模板示例展示 / 个人作品整理中</span></p></div>
      <Cards />
    </section>
    <section class="archive-contact" aria-labelledby="contact-title"><span class="eyebrow">02 / KEEP IN TOUCH</span><div class="contact-layout"><div><h2 id="contact-title">下一个想法，<br />从一次交流开始。</h2><p>关于我的经历、技能，以及还在探索的方向。</p><div class="contact-actions"><a href="/about">认识我 <span aria-hidden="true">↗</span></a><a href="/resume">查看简历 <span aria-hidden="true">↗</span></a></div></div><div class="contact-note"><span>OPEN FOR<br />NEW IDEAS</span><span class="note-star" aria-hidden="true">✳</span><Social /></div></div></section>
  </main>
</BaseLayout>

<script>
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  const opening = document.querySelector<HTMLElement>('.opening')!;
  const graphic = document.querySelector<HTMLElement>('.graphic-disc')!;
  const composition = document.querySelector<HTMLElement>('.opening-composition')!;
  let queued = false;
  const renderScroll = () => {
    queued = false;
    const progress = preference.matches ? 0 : Math.min(1, Math.max(0, -opening.getBoundingClientRect().top / opening.offsetHeight));
    graphic.style.setProperty('--scroll-turn', `${progress * 8}deg`);
    opening.style.setProperty('--unfold', `${progress}`);
    composition.style.setProperty('--scroll-shift', `${progress * -42}px`);
  };
  const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(renderScroll); } };
  addEventListener('scroll', onScroll, { passive: true });
  preference.addEventListener('change', renderScroll);
  renderScroll();

</script>

<style>
.studio{--paper:#faf9f6;--ink:#28243d;--accent:#6550d9;--line:#ddd8eb;background:var(--paper);color:var(--ink);font-family:Arial,'Noto Sans CJK SC','Microsoft YaHei',sans-serif;overflow:clip}
:global(.theme-dark) .studio{--paper:#201e2a;--ink:#f1eefb;--line:#494358}
a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid #a18bf2;outline-offset:6px}
.opening{padding:30px 6vw 50px;max-width:1600px;margin:auto}.opening-top{display:flex;justify-content:space-between;gap:24px;font:10px/1.6 monospace;letter-spacing:1px;color:var(--accent)}.opening-top i{display:inline-block;width:7px;height:7px;background:#ab91e8;border-radius:50%;margin-right:9px}
.opening-composition{display:grid;grid-template-columns:1fr 1.1fr;align-items:center;gap:5vw;min-height:620px;padding:60px 0;transform:translateY(var(--scroll-shift,0px))}.archive-label{display:inline-block;font-size:12px;letter-spacing:2px;padding:9px 14px;border:1px solid var(--line);border-radius:6px;transform:rotate(-3deg);margin-bottom:30px}h1{font:800 clamp(46px,5.7vw,88px)/1.35 Arial,'Noto Sans CJK SC','Microsoft YaHei',sans-serif;letter-spacing:-.06em;color:var(--ink);margin:0}.line-mask{display:block;overflow:hidden}.title-line{display:block}.highlight{color:var(--accent);position:relative}.hero-note{font-size:15px;letter-spacing:3px;margin:24px 0 30px;opacity:.65}.hero-button{display:inline-flex;align-items:center;gap:40px;background:var(--accent);color:#fff;padding:18px 24px;border-radius:12px;box-shadow:0 8px 0 #4936ae;transition:translate .25s,box-shadow .25s}.hero-button:hover{translate:0 4px;box-shadow:0 4px 0 #4936ae}
.graphic{position:relative;perspective:1000px;padding:30px 0 50px}.graphic-disc{transform:rotate(calc(-5deg + var(--scroll-turn,0deg)));position:relative;z-index:2}.graphic-disc img{width:100%;height:auto;display:block;border-radius:30px}.graphic-caption{position:absolute;bottom:0;right:0;font:10px monospace;letter-spacing:2px;opacity:.6}.floating-tag{position:absolute;z-index:4;border:1px solid var(--line);background:var(--paper);padding:12px 18px;border-radius:10px;font:12px monospace;box-shadow:0 6px 18px #35245710}.tag-one{top:0;left:-15px;rotate:-8deg}.tag-two{bottom:40px;right:-12px;rotate:8deg;background:#eee5ff;color:#5541a4}.project-slips{position:absolute;inset:0;z-index:3;pointer-events:none}.project-slip{position:absolute;width:25%;top:12%;left:calc(12% + var(--i)*24%);padding:6px;background:#fff;border-radius:7px;box-shadow:0 8px 24px #27203d26;transform:translateY(calc(var(--unfold,0)*-65px)) rotate(calc((var(--i) - 1)*12deg));transition:translate .4s}.project-slip img{width:100%;aspect-ratio:1.4;object-fit:cover;border-radius:4px}.project-slip span{font:6px monospace;display:block;margin:5px 0;color:#484055}.graphic:hover .project-slip{translate:0 -14px}
.opening-bottom{display:flex;align-items:end;justify-content:space-between;gap:30px;border-top:1px solid var(--line);padding-top:26px}.opening-description{max-width:520px}.opening-description p{font-size:14px;line-height:1.9;margin:0;opacity:.75}.opening-description :global(.author){border:0;margin-top:14px}.opening-description :global(.social){justify-content:flex-start;margin:0;padding:0}.discover{display:flex;gap:15px;align-items:center;font-size:12px}.circle-arrow{display:grid;place-items:center;border:1px solid var(--line);width:40px;height:40px;border-radius:50%}.index-note{font:9px/1.7 monospace;text-align:right;opacity:.5}
.archive-strip{display:flex;justify-content:space-around;align-items:center;gap:20px;background:#ded4fa;color:#47338d;padding:24px 5vw;font:600 clamp(13px,2vw,25px) monospace;letter-spacing:3px}.archive-strip i{font-style:normal;font-size:28px}
.selected-work{padding:90px 6vw 50px;--color-100:var(--ink);--filter-bg:transparent;--filter-color:var(--ink);--filter-color-active:#fff;--filter-bg-active:#6550d9;--filter-bg-hover:#dcd2f5;--filter-border:1px solid var(--line);scroll-margin-top:30px}.work-heading{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:36px}.eyebrow{display:block;font:11px monospace;letter-spacing:2px;color:var(--accent);margin-bottom:22px}h2{font-size:clamp(28px,3.2vw,48px);font-family:inherit;line-height:1.4;color:var(--ink);letter-spacing:-1px}.work-heading-arrow{width:.8em;height:.8em;margin-left:20px;color:var(--accent)}.work-heading p{font-size:13px;line-height:1.9;opacity:.65}.sample-note{font-size:11px}.selected-work :global(.filter-options){justify-content:flex-start;gap:10px}.selected-work :global(.filter-wrapper){padding:12px 0 24px;border-bottom:1px solid var(--line)}.selected-work :global(.filter-options button){border-radius:9px 9px 0 0!important;padding:12px 22px!important}.selected-work :global(.card-item){width:50%;max-width:50%;padding:0 22px;margin-bottom:60px}.selected-work :global(.card-list){margin-left:-22px;margin-right:-22px;width:calc(100% + 44px)}.selected-work :global(.card-header){margin-bottom:0;background:#e7e0f6;color:#46386a;border-radius:16px 16px 0 0;padding:15px 14px}.selected-work :global(.type-tag){color:#56477a}.selected-work :global(.card-figure){border:10px solid #e7e0f6;border-top:0;border-radius:0 0 16px 16px;box-shadow:0 10px 20px #41325c0a;transition:transform .45s,box-shadow .45s}.selected-work :global(.card-figure:hover){transform:translateY(-5px) rotate(-1deg);box-shadow:0 20px 30px #41325c1a}.selected-work :global(.card-item:nth-child(even) .card-header){background:#e5e9f3}.selected-work :global(.card-item:nth-child(even) .card-figure){border-color:#e5e9f3}.selected-work :global(.card-item__title){font:600 clamp(18px,1.6vw,24px) /1.5 Arial,'Microsoft YaHei',sans-serif;color:var(--ink)}.selected-work :global(.card-info){color:var(--ink);opacity:.6;font-size:13px}.selected-work :global(.card-footer){margin-top:20px}.selected-work :global(.tag-original){background:#ded4fa;color:#554092}.selected-work :global(.card-detail){min-width:0}
.archive-contact{padding:80px 6vw 90px;background:#eee8fa;color:#312848;border-radius:44px 44px 0 0}.archive-contact h2{color:#312848}.contact-layout{display:grid;grid-template-columns:1.5fr 1fr;gap:60px;align-items:center}.archive-contact p{font-size:14px;opacity:.6;margin:20px 0 30px}.contact-actions{display:flex;gap:14px}.contact-actions a{padding:16px 22px;background:#fff;border-radius:12px;display:flex;gap:35px;transition:translate .25s}.contact-actions a:hover{translate:0 -5px}.contact-note{justify-self:center;max-width:360px;width:100%;padding:35px;background:#faf6e9;border-radius:5px;rotate:5deg;box-shadow:8px 12px 0 #d8cceb;position:relative}.contact-note>span:first-child{font:700 clamp(28px,3vw,44px)/1.1 monospace;letter-spacing:-2px}.note-star{position:absolute;right:25px;top:30px;color:#8d70d3;font-size:60px}.contact-note :global(.author){margin-top:25px;border:0}.contact-note :global(.social){padding:0;justify-content:flex-start}
@media(prefers-reduced-motion:no-preference){.title-line{animation:rise 1.1s cubic-bezier(.16,1,.3,1) both}.title-second{animation-delay:.16s}.graphic{animation:arrive 1.3s .2s both}.selected-work :global(.card-body[data-reveal="pending"]){clip-path:inset(18% 0 0);opacity:.2}.selected-work :global(.card-body[data-reveal="visible"]){clip-path:inset(-30px -30px -40px);opacity:1}.selected-work :global(.card-body[data-reveal]){transition:clip-path 1s,opacity .8s,translate .8s}.note-star{animation:turn 24s linear infinite}}@keyframes rise{from{transform:translateY(110%)}to{transform:none}}@keyframes arrive{from{opacity:0;transform:translateY(35px) rotate(6deg)}to{opacity:1;transform:none}}@keyframes turn{to{transform:rotate(360deg)}}
@media(max-width:900px){.opening-composition{min-height:510px;gap:25px}.index-note{display:none}.work-heading{align-items:start;flex-direction:column;gap:10px}.contact-layout{gap:30px}.note-star{font-size:36px;right:15px}.contact-note{padding:25px}}
@media(max-width:600px){.opening{padding:24px 6vw 32px}.opening-top{font-size:8px;gap:15px}.opening-top>span:last-child{text-align:right}.opening-composition{grid-template-columns:1fr;gap:30px;padding:42px 0 20px}.archive-label{margin-bottom:18px;font-size:10px}h1{font-size:13vw}.hero-note{font-size:12px;margin:18px 0 24px}.hero-button{padding:14px 20px;font-size:13px}.graphic{width:88%;justify-self:center;padding:25px 0 40px}.opening-bottom{flex-wrap:wrap;gap:18px}.opening-description p{font-size:13px}.archive-strip{gap:8px;padding:18px 4vw;font-size:11px;letter-spacing:1px}.archive-strip i{font-size:17px}.selected-work{padding:50px 6vw 20px}.selected-work :global(.card-item){width:100%;max-width:100%;padding:0;margin-bottom:38px}.selected-work :global(.card-list){width:100%;margin:30px 0}.selected-work :global(.filter-options button){padding:9px 12px!important}.archive-contact{padding:45px 6vw 60px;border-radius:25px 25px 0 0}.contact-layout{grid-template-columns:1fr;gap:40px}.contact-note{width:85%;max-width:300px}.contact-actions a{font-size:13px;gap:22px}}
@media(prefers-reduced-motion:reduce){.studio *{animation:none!important;transition:none!important}}
</style>
