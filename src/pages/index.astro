---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cards from '../components/Cards.astro';
import Social from '../components/Social.astro';
import { pageTag, pageDescription, homeTdk } from '../data/content';
---
<BaseLayout title={homeTdk.title} description={homeTdk.description} keywords={homeTdk.keywords}>
  <main class="studio">
    <section class="opening" aria-labelledby="opening-title">
      <div class="opening-top"><span><i></i> {pageTag.index} / IDEAS IN MOTION</span><span>INGNAH — DESIGN EXPLORATIONS</span></div>
      <div class="opening-composition">
        <h1 id="opening-title" aria-label="设计与编程"><span class="line-mask"><span class="title-line">设计<span class="title-dot">.</span></span></span><span class="line-mask"><span class="title-line title-second"><em>&</em> 编程<span class="title-dot">.</span></span></span></h1>
        <div class="graphic" aria-hidden="true">
          <div class="graphic-disc"><svg class="disc-cross" viewBox="0 0 200 200" fill="none"><g stroke="currentColor" stroke-width="16"><path d="M100 22v156M22 100h156M45 45l110 110M45 155 155 45" /></g></svg></div>
          <div class="graphic-label"><span>DESIGN</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 19 19 5M5 5h14v14" /></svg><span>CODE</span></div>
          <span class="graphic-caption">A LITTLE SHIFT.<br />A DIFFERENT PERSPECTIVE.</span>
        </div>
      </div>
      <div class="opening-bottom">
        <div class="opening-description"><p>{pageDescription.index}</p><Social /></div>
        <a class="discover" href="#selected-work"><span>向下，看看作品</span><span class="circle-arrow" aria-hidden="true">↓</span></a>
        <span class="index-note">SCROLL TO EXPLORE<br />VISUAL / DIGITAL / EXPERIMENTAL</span>
      </div>
    </section>
    <section class="selected-work" id="selected-work" aria-labelledby="work-title">
      <div class="work-heading"><div><span class="eyebrow">WORKS & EXPLORATIONS</span><h2 id="work-title">作品与探索<svg class="work-heading-arrow" aria-hidden="true" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><path d="m8 8 30 30M12 38h26V12" /></svg></h2></div><p>视觉、交互与创意实验。<br /><span class="sample-note">原模板示例展示 / 个人作品整理中</span></p></div>
      <Cards />
    </section>
  </main>
</BaseLayout>

<script>
  const preference = matchMedia('(prefers-reduced-motion: reduce)');
  const opening = document.querySelector<HTMLElement>('.opening')!;
  const graphic = document.querySelector<HTMLElement>('.graphic-disc')!;
  const composition = document.querySelector<HTMLElement>('.opening-composition')!;
  let queued = false;
  const renderScroll = () => {
    queued = false;
    const progress = preference.matches ? 0 : Math.min(1, Math.max(0, -opening.getBoundingClientRect().top / opening.offsetHeight));
    graphic.style.setProperty('--scroll-turn', `${progress * 85}deg`);
    composition.style.setProperty('--scroll-shift', `${progress * -42}px`);
  };
  const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(renderScroll); } };
  addEventListener('scroll', onScroll, { passive: true });
  preference.addEventListener('change', renderScroll);
  renderScroll();

</script>

<style>
  .studio { --paper: #f2f1eb; --ink: #20211e; --acid: #d5ff37; background: var(--paper); color: var(--ink); font-family: Arial, 'PingFang SC', 'Microsoft YaHei', sans-serif; }
  :global(.theme-dark) .studio { --paper: #22231f; --ink: #f2f1eb; }
  .studio a { color: inherit; text-decoration: none; }
  .studio a:focus-visible { outline: 3px solid #799e00; outline-offset: 6px; }
  .opening-top, .index-note, .eyebrow, .graphic-caption { font: 11px/1.6 'Courier New', monospace; letter-spacing: 1px; }
  .opening { padding: 30px 5vw 44px; }
  .opening-top { display: flex; justify-content: space-between; align-items: center; }
  .opening-top i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #85a911; margin-right: 10px; }
  .opening-composition { position: relative; display: grid; grid-template-columns: 1fr 28%; align-items: center; gap: 24px; padding: 36px 0 30px; transform: translateY(var(--scroll-shift, 0px)); }
  h1 { color: var(--ink); font-family: Arial, "Noto Sans CJK SC", "Noto Sans Mono CJK SC", "Microsoft YaHei", sans-serif; font-size: clamp(64px, 9.5vw, 150px); font-weight: 850; letter-spacing: -.08em; line-height: 1.22; margin: 0; }
  .line-mask { display: block; overflow: hidden; padding-right: 12px; }
  .title-line { display: block; }
  h1 em { font-style: normal; color: transparent; -webkit-text-stroke: 1.7px var(--ink); }
  .title-dot { color: #8ba800; }
  .graphic { position: relative; justify-self: end; width: 100%; max-width: 310px; padding-top: 22px; }
  .graphic-disc { background: var(--acid); border-radius: 50%; aspect-ratio: 1; display: grid; place-items: center; transform: rotate(var(--scroll-turn, 0deg)); color: #20211e; }
  .disc-cross { width: 76%; height: 76%; }
  .graphic-label { position: absolute; left: -8%; top: 45%; width: 116%; background: var(--ink); color: var(--paper); display: flex; justify-content: space-between; padding: 12px 19px; font: 12px 'Courier New', monospace; transform: rotate(-11deg); }
  .graphic-caption { display: block; margin: 28px 0 0; text-align: right; opacity: .6; }
  .opening-bottom { display: flex; justify-content: space-between; align-items: end; gap: 30px; padding-top: 22px; }
  .opening-bottom p { font-size: 17px; line-height: 1.8; margin: 0; }
  .discover { display: flex; align-items: center; gap: 22px; font-size: 14px; }
  .circle-arrow { border: 1px solid var(--ink); width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; font-size: 23px; transition: background .25s, translate .25s; }
  .discover:hover .circle-arrow { background: var(--acid); color: #20211e; translate: 0 4px; }
  .index-note { text-align: right; opacity: .6; }
  .selected-work { padding: 66px 5vw 64px; background: #1b1c19; color: #f2f1eb; border-radius: 28px 28px 0 0; scroll-margin-top: 20px; }
  .work-heading { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 48px; }
  .eyebrow { display: block; opacity: .55; margin-bottom: 12px; }
  .work-heading h2 { color: #f2f1eb; font-family: inherit; font-size: clamp(32px, 4vw, 58px); font-weight: 500; letter-spacing: -2px; }
  .work-heading-arrow { width: .8em; height: .8em; color: var(--acid); margin-left: 24px; }
  .work-heading p { font-size: 14px; line-height: 1.9; margin: 0; color: #babbb4; }
  .sample-note { font-size: 12px; color: #97998e; }
  @media (prefers-reduced-motion: no-preference) {
    .title-line { animation: title-rise 1.05s cubic-bezier(.16, 1, .3, 1) both; }
    .title-second { animation-delay: .15s; }
    .graphic { animation: graphic-enter 1.3s .18s cubic-bezier(.16, 1, .3, 1) both; }
    :global(.studio .card-body[data-reveal="pending"]) { clip-path: inset(12% 0 12% 0); opacity: .2; }
    :global(.studio .card-body[data-reveal="visible"]) { clip-path: inset(-20px -30px -36px); opacity: 1; }
  }
  :global(.studio .card-body[data-reveal]) { transition: clip-path 1s cubic-bezier(.22, 1, .36, 1), opacity .8s, translate .8s; }
  @keyframes title-rise { from { transform: translateY(110%); } to { transform: translateY(0); } }
  @keyframes graphic-enter { from { opacity: 0; transform: scale(.6) rotate(-25deg); } to { opacity: 1; transform: none; } }
  @media (max-width: 900px) {
    .opening-composition { grid-template-columns: 1fr 24%; padding: 48px 0; }
    h1 { font-size: 9.5vw; }
    .graphic-label { font-size: 9px; padding: 9px; }
    .graphic-caption { font-size: 9px; letter-spacing: 0; }
  }
  @media (max-width: 600px) {
    .opening { padding: 22px 6vw 35px; }
    .opening-top { font-size: 9px; letter-spacing: .5px; }
    .opening-top > span:last-child { font-size: 9px; }
    .opening-composition { grid-template-columns: minmax(0, 1fr) 100px; align-items: end; padding: 44px 0 30px; gap: 16px; }
    h1 { font-size: 14.5vw; line-height: 1.25; letter-spacing: -.07em; }
    .graphic { width: 100px; margin: 0 5px 12px 0; }
    .graphic-caption { display: none; }

    .graphic-label { font-size: 9px; padding: 7px 10px; }
    .opening-bottom { align-items: center; gap: 16px; padding-top: 24px; }
    .opening-bottom p { font-size: 13px; }
    .index-note { display: none; }
    .discover { gap: 10px; font-size: 11px; }
    .circle-arrow { width: 38px; height: 38px; font-size: 19px; }
    .selected-work { padding: 38px 6vw; border-radius: 20px 20px 0 0; }
    .work-heading { display: block; margin-bottom: 30px; }
    .work-heading p { margin-top: 20px; font-size: 13px; }
    .sample-note { font-size: 11px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .studio *, .studio *::before, .studio *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }

  .opening-description { max-width: 520px; }
  .opening-description p { font-size: 15px; line-height: 1.9; }
  .opening-description :global(.author) { border: 0; margin-top: 18px; }
  .opening-description :global(.social) { justify-content: flex-start; margin: 0; padding: 0; }
  .selected-work {
    --color-100: #f2f1eb;
    --color-400: #b6b9ab;
    --color-700: #474a40;
    --filter-bg: #1b1c19;
    --filter-color: #d6d9cd;
    --filter-color-active: #20211e;
    --filter-bg-active: #d5ff37;
    --filter-bg-hover: #30332a;
    --filter-border: 1px solid #55594c;
  }
  .selected-work :global(.filter-options) { justify-content: flex-start; }
  .selected-work :global(.filter-wrapper) { padding: 0 0 24px; }
  .selected-work :global(.card-item) { width: 50%; max-width: 50%; padding: 0 18px; margin-bottom: 50px; }
  .selected-work :global(.card-list) { margin-left: -18px; margin-right: -18px; }
  .selected-work :global(.card-figure) { border-radius: 6px; }
  .selected-work :global(.card-item__title) { color: #f2f1eb; font-family: inherit; font-size: clamp(20px, 2.1vw, 30px); font-weight: 500; }
  .selected-work :global(.card-info) { color: #b6b9ab; font-size: 14px; margin-top: 9px; }
  .selected-work :global(.card-header) { margin-bottom: 15px; }
  .selected-work :global(.card-footer) { margin-top: 14px; }
  .selected-work :global(.card-link) { filter: brightness(2); }
  .selected-work :global(.tag-original) { background: #d5ff37; color: #20211e; }
  @media (max-width: 600px) {
    .opening-description { max-width: 100%; }
    .opening-description p { font-size: 13px; }
    .opening-bottom { flex-wrap: wrap; }
    .discover { margin-top: 8px; }
    .selected-work :global(.card-item) { width: 100%; max-width: 100%; padding: 0; margin-bottom: 36px; }
    .selected-work :global(.card-list) { margin: 0; }
    .selected-work :global(.filter-options) { gap: 8px; }
  }
</style>
