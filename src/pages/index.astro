---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cards from "../components/Cards.astro";
import SectionHeader from "../components/SectionHeader.astro";
import {pageTag, pageDescription,homeTdk} from '../data/content';
---

<BaseLayout
title={homeTdk.title  || ''}
description ={homeTdk.description  || ''}
keywords = {homeTdk.keywords  || ''}
>
	<div class="section hero">
		<div class="container">
			<div class="hero-intro">
				<div class="hero-atmosphere" aria-hidden="true">
					<span class="glow glow-warm"></span>
					<span class="glow glow-blue"></span>
					<svg class="hero-grain" width="100%" height="100%"><filter id="hero-noise"><feTurbulence type="fractalNoise" baseFrequency="0.72" numOctaves="3" stitchTiles="stitch" /></filter><rect width="100%" height="100%" filter="url(#hero-noise)" /></svg>
				</div>
			<SectionHeader
				tag={pageTag.index}
				description={pageDescription.index}>
    			设计&编程
			</SectionHeader>
			</div>
			<Cards />
		</div>
	</div>

</BaseLayout>




<style>
  .hero-intro {
    position: relative;
    isolation: isolate;
    display: flow-root;
    padding-top: 12px;
    padding-bottom: 12px;
  }
  .hero-atmosphere {
    position: absolute;
    z-index: -1;
    inset: -40px calc(50% - 50vw) -32px;
    overflow: hidden;
    pointer-events: none;
    background: radial-gradient(ellipse at 45% 35%, #fff4dc 0%, transparent 68%);
    mask-image: linear-gradient(to bottom, transparent, #000 15%, #000 70%, transparent);
  }
  .glow {
    position: absolute;
    width: min(70vw, 800px);
    height: 520px;
    border-radius: 50%;
    filter: blur(45px);
  }
  .glow-warm {
    top: -150px;
    left: 8%;
    background: radial-gradient(ellipse, rgb(245 203 118 / 35%), transparent 70%);
  }
  .glow-blue {
    top: -110px;
    right: 6%;
    background: radial-gradient(ellipse, rgb(155 187 209 / 30%), transparent 70%);
  }
  .hero-grain {
    position: absolute;
    inset: 0;
    opacity: .045;
    mix-blend-mode: multiply;
  }
  :global(.theme-dark) .hero-atmosphere {
    background: radial-gradient(ellipse at 45% 35%, #302b23 0%, transparent 68%);
  }
  :global(.theme-dark) .glow-warm { opacity: .35; }
  :global(.theme-dark) .glow-blue { opacity: .3; }
  :global(.theme-dark) .hero-grain { mix-blend-mode: soft-light; opacity: .08; }
  @media (prefers-reduced-motion: no-preference) {
    .glow-warm { animation: warm-drift 18s ease-in-out infinite alternate; }
    .glow-blue { animation: blue-drift 22s ease-in-out infinite alternate; }
  }
  @keyframes warm-drift {
    to { transform: translate(7%, 28px) scale(1.08); }
  }
  @keyframes blue-drift {
    to { transform: translate(-8%, 35px) scale(1.1); }
  }
  @media (max-width: 640px) {
    .glow { width: 95vw; height: 420px; filter: blur(30px); }
    .glow-warm { left: -30%; top: -80px; }
    .glow-blue { right: -35%; top: 0; }
  }
</style>
