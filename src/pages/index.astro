---
import BaseLayout from '../layouts/BaseLayout.astro';
import Cards from "../components/Cards.astro";
import SectionHeader from "../components/SectionHeader.astro";
import {pageTag, pageDescription,homeTdk} from '../data/content';
---

<BaseLayout
title={homeTdk.title  || ''}
description ={homeTdk.description  || ''}
keywords = {homeTdk.keywords  || ''}
>
  <div class="section hero">
    <div class="container">
      <SectionHeader
        tag={pageTag.index}
        description={pageDescription.index}>
          设计&编程
      </SectionHeader>
      <Cards />
    </div>
  </div>

</BaseLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero :global(.card-body[data-reveal]) {
      transition: clip-path 1s cubic-bezier(.22, 1, .36, 1),
        opacity .8s ease var(--reveal-delay, 0ms),
        translate .8s cubic-bezier(.22, 1, .36, 1) var(--reveal-delay, 0ms);
    }
    .hero :global(.card-body[data-reveal='pending']) {
      clip-path: inset(18% 0 0);
    }
    .hero :global(.card-body[data-reveal='visible']) {
      clip-path: inset(-30px -30px -40px);
    }
  }
</style>
